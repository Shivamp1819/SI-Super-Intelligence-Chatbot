# Server Port (default 5000)
PORT=5000

# MongoDB Connection String (MongoDB Atlas in production or local mongodb)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/chatbot?retryWrites=true&w=majority

# Security Secrets (Generate random 32+ character strings for production)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
COOKIE_SECRET=your_super_secret_cookie_key_here_min_32_chars

# Google Gemini AI API Key (from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Frontend URLs for CORS and cross-origin cookies in production (comma-separated if multiple)
# Example: https://your-frontend.vercel.app,https://yourdomain.com
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Optional: Set COOKIE_DOMAIN if you have a custom root domain and multiple subdomains (e.g. .yourdomain.com)
# Leave blank for default (binds to host origin)
COOKIE_DOMAIN=

# Optional OpenAI configuration
OPEN_AI_SECRET=
OPENAI_ORAGANIZATION_ID=

# Email SMTP Configuration (Direct SMTP works locally; on Render free tier, SMTP ports are blocked)
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Cloud HTTP Email Services (Recommended on Render to bypass SMTP port blocking)
# Option 1 - Brevo API (Sends to ANY email address, 300 free emails/day)
# Get free API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER=

# Option 2 - Resend API (Free 3000 emails/month)
# NOTE: Free Resend accounts without a custom domain deliver to the Resend account owner's email.
RESEND_API_KEY=
RESEND_FROM=SI Super Intelligence <onboarding@resend.dev>

