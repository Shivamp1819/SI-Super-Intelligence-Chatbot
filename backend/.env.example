# Server Port (default 5000)
PORT=5000

# MongoDB Connection String (MongoDB Atlas in production or local mongodb)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/chatbot?retryWrites=true&w=majority

# Security Secrets (Generate random 32+ character strings for production)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
COOKIE_SECRET=your_super_secret_cookie_key_here_min_32_chars

# Google Gemini AI API Key (from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Frontend URLs for CORS and cross-origin cookies in production (comma-separated if multiple)
# Example: https://your-frontend.vercel.app,https://yourdomain.com
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Optional: Set COOKIE_DOMAIN if you have a custom root domain and multiple subdomains (e.g. .yourdomain.com)
# Leave blank for default (binds to host origin)
COOKIE_DOMAIN=

# Optional OpenAI configuration
OPEN_AI_SECRET=
OPENAI_ORAGANIZATION_ID=

# Email SMTP Configuration (for delivering OTP verification emails)
# For Gmail: Use your Gmail address and 16-character App Password (from myaccount.google.com/apppasswords)
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
